# Local Docker Compose defaults. Replace the password and signing-key placeholders.
# Docker Compose loads .env; direct application runs need these environment variables.

# General
APP_ENV=development
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=change-me-admin-password

# Viral Game Network
# Leave empty to run the HTTP application instead of a scheduled job.
VNET_JOB_NAME=
# API key shared with game clients and server pods.
VNET_KEY=replace-with-a-random-api-key
# Private JWT signing key: at least 32 random bytes, distinct from every API key.
# Keep this value on backend services; do not distribute it to clients or game pods.
VNET_TOKEN_KEY=replace-with-a-separate-random-signing-key
VNET_NAME="Viral Game Network"
# Game-server pods must be able to reach this host and port.
VNET_HOST=http://host.docker.internal
VNET_PORT=3000
# Token lifetime in minutes.
VNET_TOKEN_EXPIRE=30

# Redis: the local Compose service does not enable authentication.
CACHE_ENDPOINT=cache:6379
CACHE_USERNAME=
CACHE_PASSWORD=

# SurrealDB: STORE_DATABASE selects the namespace; the database name is vgn.
STORE_ENDPOINT=ws://store:8000/rpc
STORE_USERNAME=root
STORE_PASSWORD=change-me-store-password
STORE_DATABASE=viral-game-network
