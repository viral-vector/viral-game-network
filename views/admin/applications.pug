div#app.my-5.mx-3
    include partials/header.pug
    #admin.container.is-fullhd.px-1.py-6
        .columns
            .column.is-one-quarter
                include partials/aside.pug
            .column(data-controller="form")
                include partials/modal_prompt.pug
                include partials/notification.pug
                section.content
                    h3.subtitle
                        | Manage Applications
                hr
                if .form
                    .buttons.is-right
                        form.form-inline(method="DELETE", action="/admin/application" .ID, name="", data-confirm-message="Are you sure you want to delete")
                            button.button.is-text.has-text-danger(type="submit") 
                                span.icon.is-small
                                    i.fa.fa-trash 
                    include partials/form.pug
                else
                    p.p-3
                       a.has-text-primary(href="/admin/application")
                        span.icon
                            span.fas.fa-plus-circle 
                        | Add Application
                    include partials/search.pug
                    .box.list
                        .grid.list-head
                            .cell
                                strong ID
                            .cell
                                strong Name
                            .cell
                                strong Guid
                            .cell
                                strong Group
                        each app in .apps
                            include partials/applications/list_item.pug
                    include partials/pager.pug