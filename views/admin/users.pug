div#app.my-5.mx-3
    include partials/header.pug
    #admin.container.is-fullhd.px-1.py-6
        .columns
            .column.is-one-quarter
                include partials/aside.pug
            .column(data-controller="form")
                include partials/modal_prompt.pug
                include partials/notification.pug
                section.content
                    h3.subtitle
                        | Manage Users
                hr
                if .form
                    include partials/form.pug
                else
                    p.notification.is-info 
                        | #{.total} users found.
                        | Viewing #{.paged} of #{.pages} pages.
                    p.p-3
                        a.has-text-primary(href="/admin/user")
                            span.icon
                                span.fas.fa-plus-circle 
                            | Add User
                    each user in .users
                        .box
                            include partials/users/list_item.pug
                    include partials/pager.pug