div#app.my-5.mx-3
    include partials/header.pug
    #admin.container.is-fullhd.px-1.py-6
        .columns
            .column.is-one-quarter
                include partials/aside.pug
            .column(data-controller="crud" data-crud-list-value="/admin/pods" data-crud-create-value="/admin/pods" data-crud-edit-value="/admin/pod/:id" data-crud-delete-value="/admin/pod/:id")
                include partials/modal_prompt.pug
                include partials/notification.pug
                section.content
                    h3.subtitle
                        | Manage k8 Pods
                hr
                if .pod 
                    p.notification.is-info
                        | Viewing #{.pod.Name}
                    include partials/pods/edit_item.pug
                else
                    p.notification.is-info 
                        | #{.total} pods found.
                        | Viewing #{.paged} of #{.pages} pages.
                    p.p-3
                       a.has-text-primary(data-action="click->crud#create")
                        span.icon
                            span.fas.fa-plus-circle 
                        | Add Pod
                    each pod in .pods
                        .box
                            include partials/pods/list_item.pug
                    include partials/pager.pug
script(src="/admin.js")