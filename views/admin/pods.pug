div#app.my-5.mx-3
    include partials/header.pug
    #admin.container.is-fullhd.px-1.py-6
        .columns
            .column.is-one-quarter
                include partials/aside.pug
            .column(data-controller="form")
                include partials/modal_prompt.pug
                include partials/notification.pug
                section.content
                    h4.subtitle
                        | Manage Server Pods
                hr
                if .pod
                    include partials/pods/view_item.pug
                else
                    include partials/search.pug
                    .box.list
                        .grid.list-head
                            .cell
                                strong ID
                            .cell
                                strong Node
                            .cell
                                strong Address
                        each pod in .pods
                            include partials/pods/list_item.pug
                    include partials/pager.pug