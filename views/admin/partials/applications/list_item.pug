.div.list-item
    .list-item-buttons
        form(method="DELETE", action="/admin/application/" .ID, name="", data-confirm-message="Are you sure you want to delete")
            button.button.is-text.has-text-danger(type="submit") 
                span.icon.is-small
                    i.fa.fa-trash
    .grid
        .cell
            a(href="/admin/application/" .ID, title="Edit Application " .Name)
                | #{strip .ID.String "Application:"}
        .cell #{.Name}
        .cell #{.Guid}
        .cell #{.Group}