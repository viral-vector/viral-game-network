p 
    a.icon.has-text-danger.is-pulled-right
        span.fas.fa-trash(data-action="click->crud#delete" data-id=.Name)
.columns
    .column
        a(href="/admin/pod/" .Name, title="Edit Pod " .Name)
            span.icon
                span.fas.fa-pencil
            | #{.Name}
    .column
        strong Phase:
        | #{.Status.Phase}
    .column
        strong Node:
        | #{.Spec.NodeName}
    .column
        strong IP:
        | #{.Status.HostIP}
                