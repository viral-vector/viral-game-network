.div.list-item
    .list-item-buttons
        form(method="DELETE", action="/admin/pod/" .Name, name="", data-confirm-message="Are you sure you want to delete")
            button.button.is-text.has-text-danger(type="submit")
                span.icon.is-small
                    i.fas.fa-trash
    .grid
        .cell
            a(href="/admin/pod/" .Name, title="View Pod " .Name)
                | #{.Name}
        .cell #{.Status.Phase}
        .cell 
            | #{.Status.HostIP}
            each cts in .Spec.Containers
                each port in .Ports
                    | #{.HostPort}
                    