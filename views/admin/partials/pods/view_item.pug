form(method="DELETE", action="/admin/pod/" .Name, name="", data-confirm-message="Are you sure you want to delete")
    button.button.is-text.has-text-danger(type="submit")
        span.icon.is-small
            i.fas.fa-trash
.section
    .container
        .content
            if .lobby
                h4.subtitle Lobby Information
                .columns
                    .column
                        strong ID:
                    .column #{strip .lobby.ID.String "Lobby:"}
                .columns
                    .column
                        strong Name:
                    .column #{.lobby.Name}
            h4.subtitle Pod Information
            .columns
                .column
                    strong Name:
                .column #{.pod.Name}
            .columns
                .column
                    strong Labels:
                .column 
                    ul
                    each lable in .pod.Labels
                        li #{.}
            .columns
                .column
                    strong Status:
                .column 
                    | #{.pod.Status.Phase}
                    br
                    ul
                        li #{.pod.Status.Message}
            .columns
                .column
                    strong Start Time:
                .column #{.pod.CreationTimestamp}
            hr
            h4.subtitle Node Information
            .columns
                .column
                    strong Node Name:
                .column #{.node.Name}
            .columns
                .column
                    strong Node IP:
                .column 
                    ul
                        each address in .node.Status.Addresses
                            li #{.Address} #{.Type}
            hr 
            h4.subtitle Pod Port Information
            .columns
                .column
                    strong Port Info:
                .column 
                    each cts in .pod.Spec.Containers
                        each port in .Ports
                            ul
                                li Name: #{.Name}
                                li HostPort: #{.HostPort}
                                li GamePort: #{.ContainerPort}
                                li #{.Protocol}
    .container
        .content
            h4.subtitle Pod Logs
            hr
            div(style="max-height: 600px; overflow-y: hidden; overflow-x: hidden;")
                each log in .logs
                    p #{.}