p 
    a.icon.has-text-danger.is-pulled-right
        span.fas.fa-trash(data-action="click->crud#delete" data-id=.Pod.Name)
.columns
    .column
        a(href="/admin/pods/" .Pod.Name, title="Edit Pod " .Pod.Name)
            span.icon
                span.fas.fa-pencil
            | #{.Pod.Name}
    .column
        strong Phase:
        | #{.Pod.Status.Phase}
    .column
        strong Node:
        | #{.Pod.Spec.NodeName}
    .column
        strong IP:
        | #{.Pod.Status.HostIP}
                