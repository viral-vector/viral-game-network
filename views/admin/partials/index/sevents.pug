.card
  header.card-header
    p.card-header-title.subtitle.is-5 System Events
    p.card-header-icon(aria-label="more options")
      span.icon
        i.fas.fa-info-circle(aria-hidden="true")
  .card-content
    .content(style="max-height: none; overflow-y: auto; overflow-x: hidden;")
      each event, idx in .sevents
        div.grid
          .cell.has-text-centered
            p.has-text-light Date
            p #{.Date_Created}
          .cell.has-text-centered
            p.has-text-light Message
            p #{.Message}
          .cell.has-text-centered
            p.has-text-light Severity
            p(class=`has-text-` .Severity) #{.Severity}
        hr
