.card
    header.card-header
        p.card-header-title.subtitle.is-5 Cluster Status
        p.card-header-icon(aria-label="more options")
            span.icon
                i.fas.fa-info-circle(aria-hidden="true")
    .card-content
        .content
            if .cluster.version
                .columns 
                    p.column
                        | K8 Version: 
                        span.tag.is-info.is-small #{.cluster.version}
                    
                    p.column
                        | Live Nodes:
                        span.tag.is-info.is-small #{.cluster.nodes.total}
                each node in .cluster.nodes.nodes
                    include cluster_node.pug
            else 
                p 
                    i.fas.fa-ban
                    span K8 cluster not running:  
                    | #{.cluster.error}   
    footer.card-footer.py-5.px-3
        div.field.is-grouped
            form.form(action="/admin/cluster/start", method="post", data-confirm-message="Start the Cluster?")
                button.button.is-primary(type="submit") 
                    i.fas.fa-play
                    | &nbsp;
                    | Start Cluster
            form.form(action="/admin/cluster/stop", method="post",  data-confirm-message="Stop the Cluster?")
                button.button.is-danger(type="submit") 
                    i.fas.fa-ban
                    | &nbsp;
                    | Stop Cluster
            form.form(action="/admin/cluster/pods/stop", method="post",  data-confirm-message="Stop all Pods?")
                button.button.is-danger(type="submit") 
                    i.fas.fa-ban
                    | &nbsp;
                    | Stop Pods
                    
