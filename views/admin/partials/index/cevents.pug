.card
    header.card-header
        p.card-header-title.subtitle.is-5 Cluster Events
        p.card-header-icon(aria-label="")
            span.icon
                i.fas.fa-info-circle(aria-hidden="true")
    .card-content
        div(style="max-height: none; overflow-y: auto; overflow-x: hidden;")
            each event, idx in .cevents
                div.grid
                    .cell.has-text-centered
                        p.has-text-light Date
                        p #{.EventTime}
                    .cell.has-text-centered
                        p.has-text-light Message
                        p #{.Message}
                    .cell.has-text-centered
                        p.has-text-light Severity
                        p(class=`has-text-` .Type) #{.Type}
                hr
