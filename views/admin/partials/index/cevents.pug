.card
    header.card-header
        p.card-header-title.subtitle.is-5 Cluster Events
        p.card-header-icon(aria-label="")
            span.icon
                i.fas.fa-info-circle(aria-hidden="true")
    .card-content
        div(style="max-height: 300px; overflow-y: auto; overflow-x: hidden;")
            each event in .cevents
                hr
                div.level
                    .level-item.has-text-centered
                        div
                            p.heading Date
                            p(style="max-width: 100%; overflow: hidden;") #{.EventTime}
                    .level-item.has-text-centered
                        div
                            p.heading Message
                            p.content(style="max-width: 100%; overflow: hidden;") #{.Message}
                    .level-item.has-text-centered
                        div
                            p.heading Severity
                            p(style="max-width: 100%; overflow: hidden;") #{.Type}
