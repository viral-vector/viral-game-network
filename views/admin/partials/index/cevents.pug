.card
    header.card-header
        p.card-header-title.subtitle.is-5 Cluster Events
        p.card-header-icon(aria-label="")
            span.icon
                i.fas.fa-info-circle(aria-hidden="true")
    .card-content
        div(style="max-height: 300px; overflow-y: auto; overflow-x: hidden;")
            each event in .cevents
                hr
                div.grid
                    .cell.has-text-centered
                        p.has-text-info Date
                        p #{.EventTime}
                    .cell.has-text-centered
                        p.has-text-info Message
                        p #{.Message}
                    .cell.has-text-centered
                        p.has-text-info Severity
                        p #{.Type}
