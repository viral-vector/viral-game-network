div.level
	.level-item.has-text-centered
		div
			p.heading Name
			p.subtitle #{.name}
	.level-item.has-text-centered
		div
			p.heading Status
			p.subtitle #{.status}
				each condition in .status.conditions 
					span.tag.is-info.is-small #{.type}: #{.status}
	.level-item.has-text-centered
		div
			p.heading IP
			p.subtitle #{.ipv4}
	.level-item.has-text-centered
		div
			p.heading Pods
			p.subtitle #{.pods}
