.card
    header.card-header
        p.card-header-icon(aria-label="")
            span.icon
                i.fas.fa-info-circle(aria-hidden="true")
    .card-content
        form.form(action="/admin/configs", method="post",  data-confirm-message="Save Configs?")
            each val, key in .configs
                .field
                    label.label= .Name
                    .control
                        if equals .Type "string"
                            input.input(type="text", name=.Key, value=.Val, is-disabled=(equals .ReadOnly true))
                        if equals .Type "number"
                            input.input(type="number", name=.Key, value=.Val, is-disabled=(equals .ReadOnly true))
                        if equals .Type "choice"
                            select.input(name=.Key, value=.Val is-disabled=(equals .ReadOnly true))
                                option(value="", selected, disabled, hidden) Choose here
                                each opt in .Options
                                    option(value=.value)= .label
                        if equals .Type "bool"
                            label.checkbox
                                input(type="checkbox", name=.Key, value=.Val is-checked=(equals .Val "true"), is-disabled=(equals .ReadOnly true)) 
                                    | #{.Name}
            hr
            .field.is-grouped
                .controls
                button.button.is-rounded.is-danger(type="submit") Save Configs