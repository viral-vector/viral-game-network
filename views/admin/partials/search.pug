nav.level(data-controller='search', data-search-action-value=.route.http)
    .level-left
    .level-right
        .level-item
            .search.field.has-addons
                p.control
                    input.input(type='text', value=.search placeholder='search...', data-search-target='control')
                p.control
                    button.button.is-link(data-search-target='button')
                        span.icon.is-small
                            i.fa.fa-search

