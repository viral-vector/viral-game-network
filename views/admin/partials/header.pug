nav#header.navbar.is-fixed-top.is-dark(role="navigation" aria-label="dropdown navigation")
  .navbar-brand
    a.navbar-item(href='/admin')
      img(src="/images/vgn.webp" alt="")
    .navbar-burger.js-burger(data-target='nav-menu')
      span
      span
      span
      span
  #nav-menu.navbar-menu
    .navbar-start
      if .admin
        .navbar-item.has-dropdown.is-hoverable
          a.navbar-link.menu-item.is-arrowless(href='/admin' is-absolute="true" is-disabled="true") Dashboard 
          .navbar-dropdown.is-hidden-desktop
            a.navbar-item.menu-item(href='/admin/applications' hset="/admin/application") Applications 
            a.navbar-item.menu-item(href='/admin/users' hset="/admin/user") Users 
            a.navbar-item.menu-item(href='/admin/lobbies' hset="/admin/lobby") Lobbies 
            a.navbar-item.menu-item(href='/admin/servers' hset="/admin/server") Servers 
        a.navbar-item.menu-item(href='/admin/admins' hset="/admin/admin") Admins 
        a.navbar-item.menu-item(href='/admin/metrics') Metrics 
        a.navbar-item.menu-item(href='/admin/events') Events 
        a.navbar-item.menu-item(href='/admin/configs') Configs 
    .navbar-end
      .navbar-item
        .field.is-grouped
          p.control
            if .admin
              span.icon
                i.fa.fa-user-shield
              | &nbsp;
              span
                | #{.admin.Name}
      .navbar-item
        .field.is-grouped
          p.control
            if .admin
              a.bd-tw-button.button.is-dark.is-soft(href="/auth/admin/logout")
                span.icon
                  i.fa.fa-sign-out
                | &nbsp;
                span.has-text-danger Logout
            else
              span.icon
                i.fa.fa-sign-in
              | &nbsp;
              span Login
  .progress-container
    progress.progress.is-info.is-small.max(max="100" data-progress-target="progress")