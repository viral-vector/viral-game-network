.div.list-item
    .list-item-buttons
        form(method="DELETE", action="/admin/server" .ID, name="", data-confirm-message="Are you sure you want to delete")
            button.button.is-text.has-text-danger(type="submit") 
                span.icon.is-small
                    i.fa.fa-trash
    .grid
        .cell
            a(href="/admin/server/" .ID, title="View Server " .Name)
                | #{strip .ID.String "Server:"}
        .cell #{strip .Lobby.ID.String "Lobby:"}
        .cell #{.Status}
        .cell #{.Address}:#{.Port}
            
                