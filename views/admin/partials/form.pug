.container
    h4.subtitle #{.form.Title}
    form(method=.form.Method, action=.form.Action, name=.form.Title, data-confirm-message=.form.Confirm)
        each field in .form.Fields
            .field
                label.label(for=.Name) #{.Label}
                .control
                    if equals .Type "bool"
                        label.checkbox
                            input(type="checkbox", name=.Name, value=.Value is-checked=(equals .Value true), is-disabled=(equals .ReadOnly true)) 
                                | #{.Name}
                    else if equals .Type "number"
                        input.input(type="number", name=.Name, value=.Value, is-disabled=.ReadOnly)
                    else if equals .Type "choice"
                        select.input(name=.Name, value=.Value is-disabled=.ReadOnly)
                            option(value="", selected, disabled, hidden) Select...
                            each opt in .Options
                                option(value=.value)= .label
                    else
                        input.input(type=.Type, name=.Name, value=.Value, placeholder=.Label, required=.Required, is-disabled=.ReadOnly)
        hr
        .field.is-grouped
            .control
                button.button.is-rounded.is-link(type="submit") Save
            .control
                button.button.is-rounded.is-light(type="reset") Reset