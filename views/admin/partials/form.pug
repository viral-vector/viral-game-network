.container
    h4.subtitle #{.form.Title}
    form.vgnform(method=.form.Method, action=.form.Action, name=.form.Title, data-confirm-message=.form.Confirm)
        each field in .form.Fields
            .field
                label.label(for=.Name) #{.Label}
                .control
                    if equals .Type "bool"
                        label.checkbox
                            input.vgnform-input(type="checkbox", name=.Name, value=.Value, is-checked=(equals .Value true), is-disabled=.ReadOnly) 
                                | #{.Name}
                    else if equals .Type "number"
                        input.input.vgnform-input(type="number", name=.Name, value=.Value, is-required=.Required, is-disabled=.ReadOnly)
                    else if equals .Type "choice"
                        select.input.vgnform-input(name=.Name, value=.Value, is-required=.Required, is-disabled=.ReadOnly)
                            option(value="", selected, disabled, hidden) Select #{.Label}
                            each opt in .Options
                                option(value=.value, is-selected=(equals .Value .value))= .label
                    else
                        input.input.vgnform-input(type="text", name=.Name, value=.Value, placeholder=.Label, is-required=.Required, is-disabled=.ReadOnly)
        br
        if equals .form.DisableSubmit false
            .field.is-grouped
                .control
                    button.button.is-link(type="submit") #{.form.Submit}
                if .form.CanReset
                    .control
                        button.button.is-light(type="reset") Reset